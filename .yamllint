---
extends: default

rules:
  # Ansible playbooks read better with generous line length for Jinja
  # expressions and long `cmd:` strings.
  line-length:
    max: 120
    allow-non-breakable-words: true
  # `yes`/`no` are idiomatic in Ansible; don't fight them.
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false
  # Required false by ansible-lint, which refuses a config that enables it.
  comments-indentation: false
  # Also required by ansible-lint: an unquoted 0644 is a surprising octal.
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  # The inline-dict style used in group_vars/all.yml for macos_defaults is
  # deliberate: one setting per line is far more readable than expanded maps.
  braces:
    max-spaces-inside: 1

ignore: |
  collections/
  captured/
  .github/
  dotfiles/
