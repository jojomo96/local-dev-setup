---
exclude_paths:
  - collections/
  - captured/
  - .github/
  # dotfiles/ holds files owned by the apps that read them — k9s skins and
  # context configs, written by k9s itself. Linting them for playbook
  # conventions (document-start markers and so on) is meaningless, and
  # "fixing" them could break the app.
  - dotfiles/

skip_list:
  # This playbook targets localhost only; `become` is deliberately unused and
  # the Homebrew/mise installers must run as the logged-in user.
  - package-latest

warn_list:
  - experimental
  # The Homebrew, oh-my-zsh and mise installers are curl|sh by upstream
  # design — there is no get_url equivalent, since the script is the install
  # mechanism. Each task carries explicit changed_when/creates guards so
  # idempotency is preserved regardless.
  - command-instead-of-module

enable_list:
  - fqcn-builtins
