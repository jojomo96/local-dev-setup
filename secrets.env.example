# ──────────────────────────────────────────────────────────────────────────────
# TEMPLATE ONLY — contains no real values. Safe to commit.
#
#   cp secrets.env.example ~/.config/devsetup/secrets.env
#   chmod 600 ~/.config/devsetup/secrets.env
#   # then fill in the real values
#
# ~/.config/devsetup/secrets.env is sourced by the managed .zshrc and is
# gitignored. Never put real credentials in this repo.
#
# BETTER STILL: don't keep long-lived keys in your shell env at all.
#
# Anything exported here is present in every shell you open. A password manager
# does not change that — it only changes where the value came from. The actual
# fix is to stop using long-lived static credentials:
#
#   1. Short-lived tokens:   `stackit auth login` instead of static S3 keys
#   2. Project-scoped:       direnv + .envrc in the one repo that needs them,
#                            so the key exists only inside that directory
#   3. Fetch on demand:      a function, not an export, so nothing sits in env:
#
#        s3creds() {
#          AWS_SECRET_ACCESS_KEY="$(keepassxc-cli show -a Password \
#            -q "$HOME/vault.kdbx" "stackit/s3")" || return 1
#          export AWS_SECRET_ACCESS_KEY
#        }
#
# Use this file only for values that genuinely must be ambient, and keep the
# credential-shaped ones out of it.
# ──────────────────────────────────────────────────────────────────────────────

# --- Vault ---
export VAULT_CORE_USERNAME=""
export VAULT_CORE_PASSWORD=""

# --- Stackit Object Storage (S3-compatible) ---
export S3_ENDPOINT_URL="https://object.storage.eu01.onstackit.cloud"
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_REGION="eu01"
